# Copy this file to ".env" (same folder) and fill in your values.
# .env is git-ignored - never commit real credentials.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexzora_lms
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# At least 32 characters. Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars

# First admin account (created on first start only)
ADMIN_EMAIL=admin@nexzora.lk
ADMIN_PASSWORD=change_me_please

# Create a demo teacher, student and classes on first start (true/false)
SEED_DEMO_DATA=true

UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173
